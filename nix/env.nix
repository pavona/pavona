{
  uv2nix,
  pyproject-nix,
  pyproject-build-systems,
  python313,
  lib,
  coreutils,
  writeText,
  callPackage,
  buildFHSEnv,
  bazelisk,
  gcc,
  gnumake,
  perl,
  cmake,
  ninja_1_11,
  pkg-config,
  git,
  verilator,
  mdbook,
  just,
  ripgrep,
  openssl,
  # static OpenSSL libraries for Rust crates
  pkgsStatic,
  libelf,
  zlib,
  stdenv,
  # Development headers and libraries for hermetic toolchains
  glibc,
  libxcrypt,
  # GCC runtime libraries (libgcc, libgcc_s)
  libgcc,
  # Libraries needed by hermetic LLVM toolchain
  # libxml2,
  libxml2_13,
  # Build tools
  srecord,
  libftdi1, # for Rust crate libftdi1-sys
  # System libraries needed by Rust crates (include dev for pkgconfig files)
  systemdLibs,
  udev,
  vcs, # eda-nix.packages.${system}.default
  libxslt, # used in doxygen builds
  # verible,
  cargo-deny,
  autoconf,
  mkShell,
}: let
  verible-versioned = callPackage ./versioned-verible.nix {};
  sv-lang-versioned = callPackage ./versioned-sv-lang.nix {};

  workspace = uv2nix.lib.workspace.loadWorkspace {
    workspaceRoot = ../.;
  };

  pyprojectOverlay = workspace.mkPyprojectOverlay {
    sourcePreference = "wheel";
  };

  python = python313;

  pythonSet =
    (callPackage pyproject-nix.build.packages {
      inherit python;
    }).overrideScope (
      lib.composeManyExtensions [
        pyproject-build-systems.overlays.default
        pyprojectOverlay
      ]
    );

  pythonEnv = pythonSet.mkVirtualEnv "pavona-env" workspace.deps.default;

  # Bazel rc file for NixOS FHS compatibility as a proper derivation
  bazelrcSite = writeText "bazelrc-site" ''
    # Auto-generated by Nix FHS shell - do not edit manually
    # NixOS FHS environment configuration

    # NixOS build settings
    common --repo_env=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
    build --spawn_strategy=local
    build --noincompatible_strict_action_env
    build --action_env=PATH=/usr/bin:/usr/sbin:/bin:/sbin
    build --action_env=HOME
    build --action_env=LD_LIBRARY_PATH=/usr/lib64:/usr/lib
    build --action_env=PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig
    build --action_env=OPENSSL_DIR=/usr
    build --action_env=OPENSSL_LIB_DIR=/usr/lib64
    build --action_env=OPENSSL_INCLUDE_DIR=/usr/include
    build --action_env=OPENSSL_STATIC=0
    build --action_env=OPENSSL_NO_VENDOR=1
    build --linkopt=-L/usr/lib
    build --linkopt=-L/usr/lib64
    build --linkopt=-L/usr/lib64/gcc/x86_64-unknown-linux-gnu/15.3.0
    build --host_linkopt=-L/usr/lib
    build --host_linkopt=-L/usr/lib64
    build --host_linkopt=-L/usr/lib64/gcc/x86_64-unknown-linux-gnu/15.3.0
  '';
  fhs =
    # FHS environment for running dynamically linked binaries (e.g., bazel toolchains)
    buildFHSEnv {
      name = "dev-fhs";
      targetPkgs = pkgs: [
        pythonEnv
        coreutils
        bazelisk
        gcc
        gnumake
        perl
        cmake
        pkg-config
        git
        verilator
        mdbook
        just
        ripgrep
        openssl
        openssl.dev # provides openssl.pc for Rust crates
        pkgsStatic.openssl # static OpenSSL libraries for Rust crates
        libelf
        zlib
        stdenv.cc.cc.lib
        vcs
        # Development headers and libraries for hermetic toolchains
        glibc
        glibc.dev
        glibc.static
        libxcrypt
        # GCC runtime libraries (libgcc, libgcc_s)
        gcc.cc
        gcc.cc.lib
        libgcc
        ninja_1_11
        # Libraries needed by hermetic LLVM toolchain
        libxml2_13
        libxml2_13.dev
        # Build tools
        srecord
        libftdi1 # for Rust crate libftdi1-sys
        # System libraries needed by Rust crates (include dev for pkgconfig files)
        systemdLibs
        systemdLibs.dev # provides libudev.pc
        udev
        libxslt # doxygen flows
        verible-versioned
        cargo-deny
        sv-lang-versioned
        autoconf
      ];

      runScript = "bash";
      profile = ''
        # Create symlink to .bazelrc-site derivation for NixOS FHS compatibility
        # The derivation is in the nix store, we just symlink to it
        if [ -e .bazelrc-site ] && [ ! -L .bazelrc-site ]; then
          echo "Warning: .bazelrc-site exists and is not a symlink, not overwriting"
        else
          ln -sf ${bazelrcSite} .bazelrc-site
        fi

        # Cleanup symlink on exit
        cleanup_bazelrc() {
          if [ -L .bazelrc-site ] && [ "$(readlink .bazelrc-site)" = "${bazelrcSite}" ]; then
            rm -f .bazelrc-site
          fi
        }
        trap cleanup_bazelrc EXIT
      '';
      # Create compatibility symlinks in the rootfs
      extraBuildCommands = ''
        # libxml2.so.2 compatibility - hermetic LLVM was built against old libxml2 ABI
        ln -sf ${libxml2_13.out}/lib/libxml2.so $out/usr/lib64/libxml2.so.2
        # bazelisk in nixpkgs has an old incompatable version of sha256sum
        ln -sf ${coreutils}/bin/sha256sum \
          $out/usr/bin/sha256sum
        # let bazelisk own the bazel installation and invocation so that
        ln -sf ${bazelisk}/bin/bazelisk $out/usr/bin/bazel
      '';
    };
in
  mkShell {
    packages = [
      fhs
    ];
    shellHook = ''
      exec ${fhs}/bin/dev-fhs
    '';
  }
