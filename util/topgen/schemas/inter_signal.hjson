{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:inter_signal",
  title: "Inter-Module Signal",
  description: "Configuration of direct signal between IP blocks",
  type: "object",
  required: ["name", "struct", "type", "act", "width"]
  properties: {
    name: { type: "string", description: "the name of the signal" },
    desc: { type: "string", description: "the inter signal description" },
    struct: { type: "string", description: "the data type of the signal" },
    package: { type: "string", description: "the package declaring the struct" },
    type: {
        type: "string",
        description: "whether the signal is unidirectional or part of a request-response pair"
    },
    act: { type: "string", description: "whether it is a request (req) or a response (rsp)" },
    inst_name: { type: "string", description: "the instance this signal connects to" },
    width: { type: ["integer", "string"], description: "the number of items of the signal for arrays" },     // can be parameterized width
    default: { type: "string", description: "default signal value; added property" },
    end_idx: { type: "integer", description: "end index of req_rsp connection (not using full width); added property" },
    top_signame: { type: "string", description: "name of the signal within the top SV file; added property" },
    index: { type: "integer", description: "the index when this is connected to an array; added property" },
  }
}
