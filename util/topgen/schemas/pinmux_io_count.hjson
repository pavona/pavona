{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:pinmux_io_count",
  title: "Pinmux I/O Count",
  description: "Number of pinmux I/Os of each type",
  type: "object",
  required: ["inouts", "inputs", "outputs", "pads"]
  properties: {
    inouts: { type: "number", description: "the count of inout ios of the io type" },
    inputs: { type: "number", description: "the count of input ios of the io type" },
    outputs: { type: "number", description: "the count of output ios of the io type" },
    pads: { type: "number", description: "the count of pads of the io type" },
  }
}
