{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:target_pinout",
  title: "Target Pinout",
  description: "Top level target's pinout configuration",
  type: "object",
  required: ["remove_ports", "remove_pads", "add_pads"]
  properties: {
    remove_ports: { type: "array", description: "List of port names to remove from the port list" },
    remove_pads: { type: "array", description: "List of pad names to remove and stub out" },
    add_pads: { type: "array", description: "List of manual pads to add" }
  }
}
