{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:pinout",
  title: "Pinout",
  description: "Top level pinout",
  type: "object",
  required: ["banks", "pads"]
  properties: {
    banks: { type: "array", description: "List of IO power banks" },
    pads: { type: "array", description: "List of pads" },
  }
}
