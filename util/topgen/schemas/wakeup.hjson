{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:wakeup",
  title: "Wakeup",
  description: "Wakeup request description",
  type: "object",
  required: ["name", "width", "module"]
  properties: {
    name: {type: "string", description: "the wakeup name"},
    width: {type: "number", description: "the width of the signal"},
    module: {type: "string", description: "the module sourcing the wakeup"},
  }
}
