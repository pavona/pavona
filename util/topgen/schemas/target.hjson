{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:target",
  title: "Target",
  description: "Hardware target for a top level design, such as an FPGA or ASIC",
  type: "object",
  required: ["name", "pinout", "pinmux"]
  properties: {
    name: { type: "string", description: "Name of target" },
    pinout: { type: "object", description: "Target-specific pinout configuration" },
    pinmux: { type: "object", description: "Target-specific pinmux configuration" }
  }
}
