{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:target",
  title: "Target",
  description: "Hardware target for a top level design, such as an FPGA or ASIC",
  type: "object",
  required: ["name", "pinout", "pinmux"]
  properties: {
    name: { type: "string", description: "Name of target" },
    pinout: {
      $ref: "urn:topgen:target_pinout",
      description: "Target-specific pinout configuration"
    },
    pinmux: {
      $ref: "urn:topgen:target_pinmux",
      description: "Target-specific pinmux configuration"
    }
  }
}
