{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:target_pinmux",
  title: "Target Pinmux",
  description: "Top level target's pinmux configuration",
  type: "object",
  required: ["special_signals"]
  properties: {
    special_signals: {
      type: "array",
      description: "List of special signals and the pad they are mapped to."
    }
  }
}
