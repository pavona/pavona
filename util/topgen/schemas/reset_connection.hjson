{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:reset_connection",
  title: "Reset Connection",
  description: "Module reset connection",
  type: "object",
  required: ["name", "domain"]
  properties: {
    name: { type: "string", description: "name of the connecting reset" }
    domain: { type: "string", description: "connected domain" }
  }
}
