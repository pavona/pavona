{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:topgen:pinmux_io",
  title: "Pinmux I/O",
  description: "Top level I/O listing for pinmux",
  type: "object",
  required: ["name", "width", "connection", "type"]
  properties: {
    name: { type: "string", description: "the name of the io" },
    width: { type: "integer", description: "the bit width of the io" },
    type: {
      enum: ["input", "output", "inout"],
      type: "string",
      description: "input, output, or inout"
    },
    idx: { type: "integer", description: "TODO" },
    pad: { type: "string", description: "Pad name for direct connections" },
    attr: {
      type: "string",
      description: "Pad type for generating the correct attribute CSR"
    }
    connection: {
      enum: ["direct", "manual", "muxed"],
      type: "string",
      description: "Specification of connection type, can be direct, manual or muxed"
    },
    desc: { type: "string", description: "Signal description" },
    glob_idx: { type: "integer", description: "TODO" },
  }
}
