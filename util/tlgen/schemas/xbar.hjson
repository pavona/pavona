{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:tlgen:xbar",
  title: "Crossbar configuration",
  description: "Configuration file for generating TL-UL crossbar",
  type: "object",
  required: ["name", "clock", "reset", "connections", "clock_connections", "nodes"]
  properties: {
    name: { type: "string", description: "Name of the crossbar" },
    clock_srcs: { type: "object" },
    clock_group: { type: "string" },
    reset: { type: "string", description: "Main reset" },
    reset_connections: {
      type: "object",
      description: '''Generated by topgen. Key is the reset signal inside IP
                   and value is the top reset signal
                   '''
    }
    clock_connections: { type: "object", description: "list of clocks" },
    domain: {
      type: "array",
      description: "Power domain for the crossbar"
      items: { type: ["string", "integer"] }
    },
    connections: {
      type: "object",
      description: "List of edge. Key is host, entry in value list is device"
    },
    nodes: {
      type: "array"
      items: { $ref: "urn:tlgen:node" }
    }
    addr_spaces: {
      type: "array",
      description: "Generated by topgen. List of address spaces used across all hosts"
      items: { type: "string" }
    },
    clock: {
      type: "string",
      description: '''Main clock. Internal components use this clock.
                   If not specified, it is assumed to be in main clock domain
                   '''
    },
    type: { type: "string", description: "Indicate Hjson type. 'xbar' always if exist" },
    inter_signal_list: {
      type: "array",
      description: "Generated by topgen. List of inter signals for this xbar"
      items: { type: "object" }
    },
  }
}
