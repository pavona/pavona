{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reggen:interrupt",
  "title": "Interrupt",
  "description": "Interrupt signal description",
  "type": "object",
  "properties": {

    // required
    "name": {"type": "string"},
    "desc": {"type": "string"},

    // optional
    "width": {"type": "number"},
    "type": {"type": "string"},
    "auto_split": {"type": "boolean"}
    "default": {}
  }

  "required": ["name", "desc"]
}
