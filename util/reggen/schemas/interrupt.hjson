{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:reggen:interrupt",
  title: "Interrupt",
  description: "Interrupt signal description",
  type: "object",
  required: ["name", "desc"],
  additionalProperties: false,
  properties: {
    // required
    name: { type: "string" },
    desc: { type: "string" },

    // optional
    width: { type: "integer" },
    type: { type: "string" },
    auto_split: { type: "boolean" }
    default: { type: ["boolean", "integer"] }
  }
}
