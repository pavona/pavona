{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:reggen:clocking_item",
  title: "Clocking Item",
  description: "Component of an IP block's clocks and resets",
  type: "object",
  properties: {
    clock: { type: "string" },
    reset: { type: "string" },
    idle: { type: "string" },
    primary: { type: "boolean" },
    internal: { type: "boolean" }
  }
}
