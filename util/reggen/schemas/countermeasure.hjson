{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:reggen:countermeasure",
  title: "Countermeasure",
  description: "Security countermeasure implemented by a given IP block",
  type: "object",
  required: ["name", "desc"]
  properties: {
    name: { type: "string" }
    desc: { type: "string" }
  }
}
