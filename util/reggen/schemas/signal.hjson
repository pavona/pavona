{
  $schema: "https://json-schema.org/draft/2020-12/schema",
  $id: "urn:reggen:signal",
  title: "Signal",
  description: "Generic signal description for an IP block",
  type: "object",
  required: ["name", "desc"]
  properties: {
    name: { type: "string" },
    desc: { type: "string" },
    width: { type: "integer", "exclusiveMinimum": 0 },
    enabled_after_reset: { type: "boolean" }
  }
}
