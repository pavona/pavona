# Doxygen lint config

PROJECT_NAME           = "cryptolib lint"
# Limit to cryptolib for now.
INPUT                  = sw/device/lib/crypto
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.c
# Lint the functions in every header, not just those with an @file block.
FILTER_PATTERNS        = *.h=quality/doxygen-file-filter.sh
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
# Strip __attribute__((...)), which Doxygen misparses as a function.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "__attribute__(x)="

# Doxygen requires at least one GENERATE_* to be enabled.
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = doxylint-xml

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
