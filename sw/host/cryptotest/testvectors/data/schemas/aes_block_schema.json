{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lowRISC/opentitan/master/sw/host/cryptotest/testvectors/data/schemas/aes_block_schema.json",
  "title": "Cryptotest AES Block Cipher Testvector",
  "description": "A list of testvectors for AES block cipher testing",
  "$defs": {
    "byte_array": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "vendor": {
        "description": "Test vector vendor name",
        "type": "string"
      },
      "test_case_id": {
        "description": "Test case ID number -- used for debugging",
        "type": "integer"
      },
      "algorithm": {
        "description": "The ACVP algorithm the test came from",
        "type": "string",
        "enum": ["ACVP-AES-ECB", "ACVP-AES-CBC", "ACVP-AES-CFB128", "ACVP-AES-OFB", "ACVP-AES-CTR"]
      },
      "revision": {
        "description": "ACVP algorithm revision the test came from",
        "type": "string"
      },
      "is_sample": {
        "description": "Whether the ACVP vector set is a sample",
        "type": "boolean"
      },
      "vs_id": {
        "description": "ACVP vector set ID the test came from",
        "type": "integer"
      },
      "tg_id": {
        "description": "ACVP test group ID the test came from",
        "type": "integer"
      },
      "test_type": {
        "description": "aft for a single operation, ctr for a counter test, mct for a Monte Carlo test",
        "type": "string",
        "enum": ["aft", "ctr", "mct"]
      },
      "operation": {
        "description": "AES operation",
        "type": "string",
        "enum": ["encrypt", "decrypt"]
      },
      "mode": {
        "description": "Block cipher mode of operation",
        "type": "string",
        "enum": ["cbc", "cfb128", "ctr", "ecb", "ofb"]
      },
      "key": {
        "description": "AES key",
        "$ref": "#/$defs/byte_array"
      },
      "iv": {
        "description": "AES intermediate value",
        "$ref": "#/$defs/byte_array"
      },
      "ciphertext": {
        "description": "Ciphertext",
        "$ref": "#/$defs/byte_array"
      },
      "plaintext": {
        "description": "Plaintext",
        "$ref": "#/$defs/byte_array"
      },
      "mct_results": {
        "description": "Expected key, IV, plaintext and ciphertext of every outer iteration of a Monte Carlo test",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {"$ref": "#/$defs/byte_array"},
            "iv": {"$ref": "#/$defs/byte_array"},
            "plaintext": {"$ref": "#/$defs/byte_array"},
            "ciphertext": {"$ref": "#/$defs/byte_array"}
          }
        }
      },
      "result": {
        "description": "Whether the device output should match the expected output",
        "type": "boolean"
      }
    }
  }
}
