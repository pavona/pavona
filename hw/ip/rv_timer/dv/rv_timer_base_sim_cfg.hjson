{
  // Name of the sim cfg - typically same as the name of the DUT.
  name: rv_timer

  // Standalone runs default to Egret. The Dragonfly wrapper overrides this
  // selector so packages, exclusions and output directories change together.
  rv_timer_top: egret

  // Structurally different top packages must never share build or coverage data.
  overrides: [
    {
      name: scratch_path
      value: "{scratch_base_path}/{name}_{rv_timer_top}-{flow}-{tool}"
    }
  ]

  // Apply the existing top mapping to every build mode, including cover_reg_top.
  // Otherwise the virtual packages can resolve independently in each build.
  sv_flist_gen_flags: ["--mapping=lowrisc:systems:top_{rv_timer_top}:0.1"]

  // Top level dut name (sv module).
  dut: rv_timer

  // Top level testbench name (sv module).
  tb: tb

  // Simulator used to sign off this block
  tool: vcs

  // Fusesoc core file used for building the file list.
  fusesoc_core: lowrisc:dv:rv_timer_sim:0.1

  // Testplan hjson file.
  testplan: "{proj_root}/hw/ip/rv_timer/data/rv_timer_testplan.hjson"

  // RAL spec - used to generate the RAL model.
  ral_spec: "{proj_root}/hw/ip/rv_timer/data/rv_timer.hjson"

  // Import additional common sim cfg files.
  import_cfgs: [// Project wide common sim cfg file
                "{proj_root}/hw/dv/tools/dvsim/common_sim_cfg.hjson",
                // Common CIP test lists
                "{proj_root}/hw/dv/tools/dvsim/tests/csr_tests.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/alert_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/intr_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/tl_access_tests.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/sec_cm_tests.hjson",
                // rv_timer is using reset-safe stress wrappers while the TB migration is in
                // progress. These entries map stress tests onto rv_timer_rst_safe_base_test.
                "{proj_root}/hw/dv/tools/dvsim/tests/rst_safe_stress_tests.hjson"]

  // Add additional tops for simulation.
  sim_tops: ["rv_timer_bind", "sec_cm_prim_onehot_check_bind"]

  // Default iterations for all tests - each test entry can override this.
  reseed: 20

  // Common unreachable logic and only the selected top's RACL toggle widths.
  // These exclusions assume the testbench's fixed EnableRacl=0 configuration.
  vcs_cov_excl_files: ["{proj_root}/hw/ip/rv_timer/dv/cov/rv_timer_unr_excl.el",
                      "{proj_root}/hw/ip/rv_timer/dv/cov/rv_timer_racl_exclusions.el",
                      "{proj_root}/hw/ip/rv_timer/dv/cov/rv_timer_{rv_timer_top}_racl_exclusions.el"]

  // Default UVM test and seq class name.
  uvm_test: rv_timer_base_test
  uvm_test_seq: rv_timer_base_vseq

  // Enable cdc instrumentation.
  run_opts: ["+cdc_instrumentation_enabled=1"]

  // List of test specifications.
  tests: [
    {
      name: rv_timer_rst_safe_min
      uvm_test: rv_timer_rst_safe_base_test
      uvm_test_seq: rv_timer_rst_safe_min_vseq
      reseed: 10
      run_opts: ["+test_timeout_ns=10000000000"]
    }

    {
      name: rv_timer_rst_safe_max
      uvm_test: rv_timer_rst_safe_base_test
      uvm_test_seq: rv_timer_rst_safe_max_vseq
      reseed: 10
      run_opts: ["+test_timeout_ns=10000000000"]
    }

    {
      name: rv_timer_rst_safe_cfg_update_on_fly
      uvm_test: rv_timer_rst_safe_base_test
      uvm_test_seq: rv_timer_rst_safe_cfg_update_on_fly_vseq
      reseed: 10
      // 10s
      run_opts: ["+zero_delays=1", "+test_timeout_ns=10000000000"]
    }

    {
      name: rv_timer_rst_safe_smoke
      uvm_test: rv_timer_rst_safe_base_test
      uvm_test_seq: rv_timer_rst_safe_smoke_vseq
      reseed: 20
      run_opts: ["+test_timeout_ns=10000000000"]
    }

    {
      name: rv_timer_rst_safe_smoke_with_rand_reset
      uvm_test: rv_timer_rst_safe_base_test
      uvm_test_seq: rv_timer_rst_safe_smoke_with_rand_reset_vseq
      reseed: 20
      run_opts: ["+test_timeout_ns=10000000000"]
    }

    {
      name: rv_timer_rst_safe_disabled
      uvm_test: rv_timer_rst_safe_base_test
      uvm_test_seq: rv_timer_rst_safe_disabled_vseq
      reseed: 20
      run_opts: ["+test_timeout_ns=10000000000"]
    }
  ]

  // List of regressions.
  regressions: [
    {
      name: smoke
      tests: ["rv_timer_rst_safe_smoke",
              "rv_timer_rst_safe_smoke_with_rand_reset"]
    }
  ]
}
