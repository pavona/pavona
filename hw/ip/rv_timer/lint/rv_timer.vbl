# Verible waiver file for rv_timer

# The reset-safe sequences create their parameter objects with the names used by
# dv_rand_rst_safe_base_vseq, which differ from the handle names.
waive --rule=create-object-name-match --location="rv_timer_rst_safe_.*_vseq\.sv"
