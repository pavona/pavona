{
  // Name of the sim cfg - typically same as the name of the DUT.
  name: dma

  // Top level dut name (sv module).
  dut: dma

  // Top level testbench name (sv module).
  tb: tb

  // Simulator used to sign off this block
  tool: xcelium

  // Fusesoc core file used for building the file list.
  fusesoc_core: lowrisc:dv:dma_sim:0.1

  // Testplan hjson file.
  testplan: "{proj_root}/hw/ip/dma/data/dma_testplan.hjson"

  // RAL spec - used to generate the RAL model.
  ral_spec: "{proj_root}/hw/ip/dma/data/dma.hjson"

  // Import additional common sim cfg files.
  import_cfgs: [// Project wide common sim cfg file
                "{proj_root}/hw/dv/tools/dvsim/common_sim_cfg.hjson",
                // Common CIP test lists
                "{proj_root}/hw/dv/tools/dvsim/tests/alert_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/csr_tests.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/intr_test.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/sec_cm_tests.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/stress_tests.hjson",
                "{proj_root}/hw/dv/tools/dvsim/tests/tl_access_tests.hjson"]

  // Default iterations for all tests - each test entry can override this.
  reseed: 1

  // Default UVM test and seq class name.
  uvm_test: dma_base_test
  uvm_test_seq: dma_base_vseq

  sim_tops: ["dma_cov_bind", "dma_bind"]

  // The AES model DPI #includes headers from lowrisc:model:aes. FuseSoC emits +incdir+ for SV but
  // VCS's C compiler needs explicit -I flags; pass them via -CFLAGS.
  // The linker also needs -lcrypto for the OpenSSL EVP functions used by the AES reference model.
  build_opts: ["-CFLAGS -I{build_dir}/fusesoc-work/src/lowrisc_model_aes_1.0",
               "-CFLAGS -I{build_dir}/fusesoc-work/src/lowrisc_dv_aes_model_dpi_0",
               "-LDFLAGS -lcrypto"]

  xcelium_cov_refine_files: []

  // List of test specifications.
  tests: [
    {
      name: dma_generic_smoke
      uvm_test_seq: dma_generic_smoke_vseq
      reseed: 50
    }
    {
      name: dma_memory_smoke
      uvm_test_seq: dma_memory_smoke_vseq
      reseed: 25
    }
    {
      name: dma_handshake_smoke
      uvm_test_seq: dma_handshake_smoke_vseq
      reseed: 25
    }
    {
      name: dma_memory_region_lock
      uvm_test_seq: dma_memory_region_lock_vseq
      reseed: 5
    }
    {
      name: dma_abort
      uvm_test_seq: dma_abort_vseq
      reseed: 5
    }
    {
      name: dma_abort_drain
      uvm_test_seq: dma_abort_drain_vseq
      reseed: 5
    }
    {
      name: dma_short_transfer
      uvm_test_seq: dma_short_transfer_vseq
      reseed: 25
    }
    {
      name: dma_longer_transfer
      uvm_test_seq: dma_longer_transfer_vseq
      run_opts: ["+test_timeout_ns=300_000_000_000"]
      reseed: 5
    }
    {
      name: dma_mem_enabled
      uvm_test_seq: dma_mem_enabled_vseq
      reseed: 5
    }
    {
      name: dma_hashing_partial
      uvm_test_seq: dma_hashing_partial_vseq
      reseed: 20
    }
    {
      name: dma_overlap
      uvm_test_seq: dma_overlap_vseq
      reseed: 15
    }
    {
      name: dma_memset
      uvm_test_seq: dma_memset_vseq
      reseed: 15
    }
    {
      name: dma_verify
      uvm_test_seq: dma_verify_vseq
      reseed: 15
    }
    {
      name: dma_partial_size
      uvm_test_seq: dma_partial_size_vseq
      reseed: 5
    }
    {
      name: dma_range_partial
      uvm_test_seq: dma_range_partial_vseq
      reseed: 1
    }
    {
      name: dma_aes_smoke
      uvm_test_seq: dma_aes_smoke_vseq
      reseed: 1
    }
    {
      name: dma_aes_fifo
      uvm_test_seq: dma_aes_fifo_vseq
      reseed: 1
    }
    {
      name: dma_aes
      uvm_test_seq: dma_aes_vseq
      reseed: 5
    }
    {
      name: dma_aes_error
      uvm_test_seq: dma_aes_error_vseq
      reseed: 1
    }
    {
      name: dma_aes_abort
      uvm_test_seq: dma_aes_abort_vseq
      reseed: 5
    }
    {
      name: dma_aes_clear_mid_commit
      uvm_test_seq: dma_aes_clear_mid_commit_vseq
      reseed: 5
    }
    {
      name: dma_aes_bus_err
      uvm_test_seq: dma_aes_bus_err_vseq
      reseed: 5
    }
    {
      name: dma_config_lock
      uvm_test_seq: dma_config_lock_vseq
      reseed: 15
    }
    {
      name: dma_generic_stress
      uvm_test_seq: dma_generic_stress_vseq
      run_opts: ["+test_timeout_ns=300_000_000_000"]
      reseed: 5
    }
    {
      name: dma_memory_stress
      uvm_test_seq: dma_memory_stress_vseq
      run_opts: ["+test_timeout_ns=300_000_000_000"]
      reseed: 3
    }
    {
      name: dma_handshake_stress
      uvm_test_seq: dma_handshake_stress_vseq
      run_opts: ["+test_timeout_ns=300_000_000_000"]
      reseed: 3
    }
    {
      name: dma_stress_all
      uvm_test_seq: dma_stress_all_vseq
      run_opts: ["+test_timeout_ns=300_000_000_000"]
      reseed: 3
    }
  ]

  // List of regressions.
  regressions: [
    {
      name: smoke
      tests: ["dma_memory_smoke", "dma_handshake_smoke", "dma_generic_smoke", "dma_aes_smoke"]
    }
    {
      name: stress
      tests: ["dma_memory_stress", "dma_handshake_stress", "dma_generic_stress", "dma_stress_all",
              "dma_aes", "dma_aes_fifo", "dma_aes_bus_err", "dma_aes_abort", "dma_aes_clear_mid_commit"]
    }
  ]
}
