{
  build_modes: [
    {
      name: cover_reg_top
    }
  ]

  tests: [
    {
      // The common test supplies the block configuration to the shared access-error workload.
      name: "{name}_rst_safe_tl_errors"
      build_mode: "cover_reg_top"
      uvm_test: "{name}_rst_safe_common_test"
      uvm_test_seq: "cip_rst_safe_tl_errors_vseq"
      reseed: 20
    }
  ]
}
