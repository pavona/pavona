{
  testpoints: [
    {
      name: stress_all
      desc: '''
            Run reset-safe stress child sequences without injecting reset.
            '''
      stage: V2
      tests: ["{name}_rst_safe_stress_all"]
    }
    {
      name: stress_all_with_rand_reset
      desc: '''
            Run reset-safe stress child sequences while injecting random resets.
            '''
      stage: V3
      tests: ["{name}_rst_safe_stress_all_with_rand_reset"]
    }
  ]
}
