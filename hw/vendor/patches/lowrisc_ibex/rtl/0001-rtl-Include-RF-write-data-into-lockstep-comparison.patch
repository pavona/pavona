From 01f471aeaa7c8e2a9c1f853634870c683251fa9f Mon Sep 17 00:00:00 2001
From: Pascal Nasahl <nasahlpa@lowrisc.org>
Date: Thu, 5 Nov 2026 08:22:57 +0100
Subject: [PATCH 1/2] [rtl] Include RF write data into lockstep comparison

A fault into the main core could change a xor into a xnor (or similar).
In this case, the computed result is the inverse of the non-faulty
result. As the ECC of fault and non-faulty result are identical, this
fault can get unnoticed in the split register file inside the lockstep.
There, we only store the faulty data of the main core in the main core
RF and the ECC of the shadow core in the shadow core RF, which matches.

To mitigate this, compare the RF write data that is proced in the main
and shadow core in the lockstep comparison.

This adds 2x38-bits for the main core + 1x38-bits for the shadow core,
i.e., 114 FFs.

Signed-off-by: Pascal Nasahl <nasahlpa@lowrisc.org>
(cherry picked from commit 64a2b6581da7bf646ba80cfa4eca4f456a428b7f)
---
 ibex_lockstep.sv | 69 ++++++++++++++++++++++++++++--------------------
 ibex_top.sv      | 15 +++++++++++
 2 files changed, 55 insertions(+), 29 deletions(-)

diff --git a/ibex_lockstep.sv b/ibex_lockstep.sv
index 4f0d484969..ccdb987c84 100644
--- a/ibex_lockstep.sv
+++ b/ibex_lockstep.sv
@@ -75,6 +75,9 @@ module ibex_lockstep import ibex_pkg::*; #(
   input  logic [MemDataWidth-1:0]      data_rdata_i,
   input  logic                         data_err_i,
 
+  input  logic [4:0]                   rf_waddr_wb_i,
+  input  logic                         rf_we_wb_i,
+  input  logic [RegFileDataWidth-1:0]  rf_wdata_wb_i,
   input  logic [RegFileDataWidth-1:0]  rf_rdata_a_i,
   input  logic [RegFileDataWidth-1:0]  rf_rdata_b_i,
 
@@ -333,26 +336,29 @@ module ibex_lockstep import ibex_pkg::*; #(
   ///////////////////
 
   typedef struct packed {
-    logic                    instr_req;
-    logic [31:0]             instr_addr;
-    logic                    data_req;
-    logic                    data_we;
-    logic [3:0]              data_be;
-    logic [31:0]             data_addr;
-    logic [31:0]             data_wdata;
-    logic [IC_NUM_WAYS-1:0]  ic_tag_req;
-    logic                    ic_tag_write;
-    logic [IC_INDEX_W-1:0]   ic_tag_addr;
-    logic [TagSizeECC-1:0]   ic_tag_wdata;
-    logic [IC_NUM_WAYS-1:0]  ic_data_req;
-    logic                    ic_data_write;
-    logic [IC_INDEX_W-1:0]   ic_data_addr;
-    logic [LineSizeECC-1:0]  ic_data_wdata;
-    logic                    ic_scr_key_req;
-    logic                    irq_pending;
-    crash_dump_t             crash_dump;
-    logic                    double_fault_seen;
-    ibex_mubi_t              core_busy;
+    logic                        instr_req;
+    logic [31:0]                 instr_addr;
+    logic                        data_req;
+    logic                        data_we;
+    logic [3:0]                  data_be;
+    logic [31:0]                 data_addr;
+    logic [31:0]                 data_wdata;
+    logic [4:0]                  rf_waddr_wb;
+    logic                        rf_we_wb;
+    logic [RegFileDataWidth-1:0] rf_wdata_wb;
+    logic [IC_NUM_WAYS-1:0]      ic_tag_req;
+    logic                        ic_tag_write;
+    logic [IC_INDEX_W-1:0]       ic_tag_addr;
+    logic [TagSizeECC-1:0]       ic_tag_wdata;
+    logic [IC_NUM_WAYS-1:0]      ic_data_req;
+    logic                        ic_data_write;
+    logic [IC_INDEX_W-1:0]       ic_data_addr;
+    logic [LineSizeECC-1:0]      ic_data_wdata;
+    logic                        ic_scr_key_req;
+    logic                        irq_pending;
+    crash_dump_t                 crash_dump;
+    logic                        double_fault_seen;
+    ibex_mubi_t                  core_busy;
   } delayed_outputs_t;
 
   delayed_outputs_t [OutputsOffset-1:0]  core_outputs_q;
@@ -367,6 +373,9 @@ module ibex_lockstep import ibex_pkg::*; #(
   assign core_outputs_in.data_be             = data_be_i;
   assign core_outputs_in.data_addr           = data_addr_i;
   assign core_outputs_in.data_wdata          = data_wdata_i;
+  assign core_outputs_in.rf_waddr_wb         = rf_waddr_wb_i;
+  assign core_outputs_in.rf_we_wb            = rf_we_wb_i;
+  assign core_outputs_in.rf_wdata_wb         = rf_wdata_wb_i;
   assign core_outputs_in.ic_tag_req          = ic_tag_req_i;
   assign core_outputs_in.ic_tag_write        = ic_tag_write_i;
   assign core_outputs_in.ic_tag_addr         = ic_tag_addr_i;
@@ -390,10 +399,11 @@ module ibex_lockstep import ibex_pkg::*; #(
   end
 
   // The following outputs are generated by the shadow core and directly fed into the shadow core
-  // register file. There is no need to compare those signals against the signals generated by the
-  // main core in the lockstep comparison. A fault into one of those signals will cause a mismatch
-  // in the main core and shadow core register file instances. As the outputs of both register
-  // files are combined, the ECC checker inside the shadow core will detect the fault.
+  // register file. The write port signals are additionally compared against the main core in the
+  // lockstep comparison. Relying only on the ECC check when the register is read is not
+  // sufficient: a faulty value written by the main core is not detected if it happens to have the
+  // same ECC check bits as the value computed by the shadow core. This is always the case for a
+  // bitwise inverted value (e.g., XOR executed as XNOR).
   logic [RegFileDataEccWidth-1:0] shadow_rf_wdata_wb_ecc;
   logic [4:0]                     shadow_rf_raddr_a;
   logic [4:0]                     shadow_rf_raddr_b;
@@ -558,16 +568,17 @@ module ibex_lockstep import ibex_pkg::*; #(
     .core_busy_o            (shadow_outputs_d.core_busy)
   );
 
+  // Compare the register file write port of the shadow core against the one of the main core. Only
+  // the data bits are compared, the ECC bits are written into the shadow register file.
+  assign shadow_outputs_d.rf_waddr_wb = shadow_rf_waddr_wb;
+  assign shadow_outputs_d.rf_we_wb    = shadow_rf_we_wb;
+  assign shadow_outputs_d.rf_wdata_wb = shadow_rf_wdata_wb_ecc[RegFileDataWidth-1:0];
+
   // Register the shadow core outputs
   always_ff @(posedge clk_i) begin
     shadow_outputs_q <= shadow_outputs_d;
   end
 
-  // The lower RegFileDataWidth bits (which are the data bits) are not fed into the shadow
-  // register file as they are handled by the main register file.
-  logic [RegFileDataWidth-1:0] unused_shadow_rf_wdata_wb_ecc;
-  assign unused_shadow_rf_wdata_wb_ecc = shadow_rf_wdata_wb_ecc[RegFileDataWidth-1:0];
-
   //////////////////////////
   // Shadow register file //
   //////////////////////////
diff --git a/ibex_top.sv b/ibex_top.sv
index 4be4a7d7a8..6515f32851 100644
--- a/ibex_top.sv
+++ b/ibex_top.sv
@@ -803,6 +803,9 @@ module ibex_top import ibex_pkg::*; #(
       data_wdata_o,
       data_rdata_core,
       data_err_i,
+      rf_waddr_wb,
+      rf_we_wb,
+      rf_wdata_wb,
       rf_rdata_a,
       rf_rdata_b,
       ic_tag_req,
@@ -850,6 +853,9 @@ module ibex_top import ibex_pkg::*; #(
     logic [MemDataWidth-1:0]      data_rdata_local;
     logic                         data_err_local;
 
+    logic [4:0]                   rf_waddr_wb_local;
+    logic                         rf_we_wb_local;
+    logic [RegFileDataWidth-1:0]  rf_wdata_wb_local;
     logic [RegFileDataWidth-1:0]  rf_rdata_a_local;
     logic [RegFileDataWidth-1:0]  rf_rdata_b_local;
 
@@ -896,6 +902,9 @@ module ibex_top import ibex_pkg::*; #(
       data_wdata_o,
       data_rdata_core,
       data_err_i,
+      rf_waddr_wb,
+      rf_we_wb,
+      rf_wdata_wb,
       rf_rdata_a,
       rf_rdata_b,
       ic_tag_req,
@@ -939,6 +948,9 @@ module ibex_top import ibex_pkg::*; #(
       data_wdata_local,
       data_rdata_local,
       data_err_local,
+      rf_waddr_wb_local,
+      rf_we_wb_local,
+      rf_wdata_wb_local,
       rf_rdata_a_local,
       rf_rdata_b_local,
       ic_tag_req_local,
@@ -1050,6 +1062,9 @@ module ibex_top import ibex_pkg::*; #(
       .data_rdata_i             (data_rdata_local),
       .data_err_i               (data_err_local),
 
+      .rf_waddr_wb_i            (rf_waddr_wb_local),
+      .rf_we_wb_i               (rf_we_wb_local),
+      .rf_wdata_wb_i            (rf_wdata_wb_local),
       .rf_rdata_a_i             (rf_rdata_a_local),
       .rf_rdata_b_i             (rf_rdata_b_local),
 
