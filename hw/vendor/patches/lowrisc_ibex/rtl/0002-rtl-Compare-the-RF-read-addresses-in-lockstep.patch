From 37c0166219e29dd0ca6f0d0f2d799a7795c41638 Mon Sep 17 00:00:00 2001
From: Pascal Nasahl <nasahlpa@lowrisc.org>
Date: Thu, 5 Nov 2026 08:47:06 +0100
Subject: [PATCH 2/2] [rtl] Compare the RF read addresses in lockstep

A fault into the RF read address could deliver the wrong data
word from the RF. Before this commit, such a fault could get
undetected for the following cases:
- 1/128 chance that the faulty and non-faulty ECC collide
- 100% chance for faulty_data = inverse(non-faulty_data)

To close this gap, add the RF read address into the lockstep
comparison.

This adds 10-bits x 3 stages, i.e., 30 FFs.

Signed-off-by: Pascal Nasahl <nasahlpa@lowrisc.org>
(cherry picked from commit 9c2734233ad1beb1dc37f3133dffa8aa1b81be99)
---
 ibex_lockstep.sv | 23 ++++++++++++++++-------
 ibex_top.sv      | 10 ++++++++++
 2 files changed, 26 insertions(+), 7 deletions(-)

diff --git a/ibex_lockstep.sv b/ibex_lockstep.sv
index ccdb987c84..84a7da8639 100644
--- a/ibex_lockstep.sv
+++ b/ibex_lockstep.sv
@@ -75,6 +75,8 @@ module ibex_lockstep import ibex_pkg::*; #(
   input  logic [MemDataWidth-1:0]      data_rdata_i,
   input  logic                         data_err_i,
 
+  input  logic [4:0]                   rf_raddr_a_i,
+  input  logic [4:0]                   rf_raddr_b_i,
   input  logic [4:0]                   rf_waddr_wb_i,
   input  logic                         rf_we_wb_i,
   input  logic [RegFileDataWidth-1:0]  rf_wdata_wb_i,
@@ -343,6 +345,8 @@ module ibex_lockstep import ibex_pkg::*; #(
     logic [3:0]                  data_be;
     logic [31:0]                 data_addr;
     logic [31:0]                 data_wdata;
+    logic [4:0]                  rf_raddr_a;
+    logic [4:0]                  rf_raddr_b;
     logic [4:0]                  rf_waddr_wb;
     logic                        rf_we_wb;
     logic [RegFileDataWidth-1:0] rf_wdata_wb;
@@ -373,6 +377,8 @@ module ibex_lockstep import ibex_pkg::*; #(
   assign core_outputs_in.data_be             = data_be_i;
   assign core_outputs_in.data_addr           = data_addr_i;
   assign core_outputs_in.data_wdata          = data_wdata_i;
+  assign core_outputs_in.rf_raddr_a          = rf_raddr_a_i;
+  assign core_outputs_in.rf_raddr_b          = rf_raddr_b_i;
   assign core_outputs_in.rf_waddr_wb         = rf_waddr_wb_i;
   assign core_outputs_in.rf_we_wb            = rf_we_wb_i;
   assign core_outputs_in.rf_wdata_wb         = rf_wdata_wb_i;
@@ -399,11 +405,11 @@ module ibex_lockstep import ibex_pkg::*; #(
   end
 
   // The following outputs are generated by the shadow core and directly fed into the shadow core
-  // register file. The write port signals are additionally compared against the main core in the
-  // lockstep comparison. Relying only on the ECC check when the register is read is not
-  // sufficient: a faulty value written by the main core is not detected if it happens to have the
-  // same ECC check bits as the value computed by the shadow core. This is always the case for a
-  // bitwise inverted value (e.g., XOR executed as XNOR).
+  // register file. The read addresses and the write port signals are additionally compared against
+  // the main core in the lockstep comparison. Relying only on the ECC check when the register is
+  // read is not sufficient: a faulty value is not detected if it happens to have the same ECC check
+  // bits as the correct value. This is always the case for a bitwise inverted value, e.g., when XOR
+  // is executed as XNOR or when a faulty read address selects a register holding the inverse.
   logic [RegFileDataEccWidth-1:0] shadow_rf_wdata_wb_ecc;
   logic [4:0]                     shadow_rf_raddr_a;
   logic [4:0]                     shadow_rf_raddr_b;
@@ -568,8 +574,11 @@ module ibex_lockstep import ibex_pkg::*; #(
     .core_busy_o            (shadow_outputs_d.core_busy)
   );
 
-  // Compare the register file write port of the shadow core against the one of the main core. Only
-  // the data bits are compared, the ECC bits are written into the shadow register file.
+  // Compare the register file read addresses and write port of the shadow core against the ones of
+  // the main core. Only the data bits are compared, the ECC bits are written into the shadow
+  // register file.
+  assign shadow_outputs_d.rf_raddr_a  = shadow_rf_raddr_a;
+  assign shadow_outputs_d.rf_raddr_b  = shadow_rf_raddr_b;
   assign shadow_outputs_d.rf_waddr_wb = shadow_rf_waddr_wb;
   assign shadow_outputs_d.rf_we_wb    = shadow_rf_we_wb;
   assign shadow_outputs_d.rf_wdata_wb = shadow_rf_wdata_wb_ecc[RegFileDataWidth-1:0];
diff --git a/ibex_top.sv b/ibex_top.sv
index 6515f32851..2b2f01b44a 100644
--- a/ibex_top.sv
+++ b/ibex_top.sv
@@ -803,6 +803,8 @@ module ibex_top import ibex_pkg::*; #(
       data_wdata_o,
       data_rdata_core,
       data_err_i,
+      rf_raddr_a,
+      rf_raddr_b,
       rf_waddr_wb,
       rf_we_wb,
       rf_wdata_wb,
@@ -853,6 +855,8 @@ module ibex_top import ibex_pkg::*; #(
     logic [MemDataWidth-1:0]      data_rdata_local;
     logic                         data_err_local;
 
+    logic [4:0]                   rf_raddr_a_local;
+    logic [4:0]                   rf_raddr_b_local;
     logic [4:0]                   rf_waddr_wb_local;
     logic                         rf_we_wb_local;
     logic [RegFileDataWidth-1:0]  rf_wdata_wb_local;
@@ -902,6 +906,8 @@ module ibex_top import ibex_pkg::*; #(
       data_wdata_o,
       data_rdata_core,
       data_err_i,
+      rf_raddr_a,
+      rf_raddr_b,
       rf_waddr_wb,
       rf_we_wb,
       rf_wdata_wb,
@@ -948,6 +954,8 @@ module ibex_top import ibex_pkg::*; #(
       data_wdata_local,
       data_rdata_local,
       data_err_local,
+      rf_raddr_a_local,
+      rf_raddr_b_local,
       rf_waddr_wb_local,
       rf_we_wb_local,
       rf_wdata_wb_local,
@@ -1062,6 +1070,8 @@ module ibex_top import ibex_pkg::*; #(
       .data_rdata_i             (data_rdata_local),
       .data_err_i               (data_err_local),
 
+      .rf_raddr_a_i             (rf_raddr_a_local),
+      .rf_raddr_b_i             (rf_raddr_b_local),
       .rf_waddr_wb_i            (rf_waddr_wb_local),
       .rf_we_wb_i               (rf_we_wb_local),
       .rf_wdata_wb_i            (rf_wdata_wb_local),
