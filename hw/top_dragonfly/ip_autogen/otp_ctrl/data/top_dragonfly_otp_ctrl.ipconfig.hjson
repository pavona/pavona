              offset: 292
            }
            {
              name: CREATOR_SW_CFG_IMMUTABLE_ROM_EXT_SHA256_HASH
              size: 32
              desc: SHA256 hash of the immutable ROM_EXT section.
              isdigest: false
              iszer: false
              ismubi: false
              iskeymgr_creator: false
              iskeymgr_owner: false
              absorb: false
